<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ra.set">

    <!-- Required for Firebase & API calls -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".SETApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_wallet"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_wallet"
        android:supportsRtl="true"
        android:theme="@style/Theme.SET">

        <!-- DASHBOARD (After successful login) -->
        <activity
            android:name=".activities.DashboardActivity"
            android:exported="false" />
        <activity android:name=".activities.ProfileActivity" />

        <!-- EXPENSES -->
        <activity
            android:name=".activities.ExpensesActivity"
            android:exported="false" />

        <!-- ADD EXPENSE -->
        <activity
            android:name=".activities.AddExpenseActivity"
            android:exported="false" />

        <!-- EDIT EXPENSE -->
        <activity
            android:name=".activities.EditExpenseActivity"
            android:exported="false" />

        <!-- REPORTS -->
        <activity
            android:name=".activities.ReportsActivity"
            android:exported="false" />

        <!-- EXPORT -->
        <activity
            android:name=".activities.ExportActivity"
            android:exported="false" />

        <!-- REGISTER -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false" />

        <!-- LOGIN (Launcher Activity) -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>


</manifest>
