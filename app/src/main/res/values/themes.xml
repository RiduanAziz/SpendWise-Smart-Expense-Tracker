<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme -->
    <style name="Theme.SET" parent="Theme.Material3.Light.NoActionBar">

        <!-- Primary colors -->
        <item name="colorPrimary">#4F46E5</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- Secondary -->
        <item name="colorSecondary">#6366F1</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <!-- Background -->
        <item name="android:windowBackground">#EEF2FF</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">#EEF2FF</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Disable ActionBar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

    </style>

</resources>
